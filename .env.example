# Auth0 (Regular Web Application)
AUTH0_DOMAIN=dev-xxxx.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
AUTH0_SECRET= # openssl rand -hex 32
APP_BASE_URL=http://localhost:3000

# Tiger Data / TimescaleDB
DATABASE_URL= # postgres://tsdbadmin:...@host:port/tsdb?sslmode=require
DB_POOL_MAX=5
DATABASE_URL_TEST= # npm run test:db only; a `tiger service fork`, never production

# Gemini via Vertex AI + Application Default Credentials (local: `gcloud auth application-default login`;
# production: docker-compose mounts ./gcp-sa.json and sets GOOGLE_APPLICATION_CREDENTIALS)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
GEMINI_SEARCH_MODEL=gemini-3.8-flash

# Barcode lookup
DATAANDAPIS_KEY=
OFF_BASE_URL=https://world.openfoodfacts.org
OFF_USER_AGENT=Chefly/0.1 (team@example.com)
RECIPE_FETCH_USER_AGENT=CheflyRecipeFetcher/0.1 (+https://chefly.tech/bot)

# ElevenLabs (optional; /api/tts falls back to speechSynthesis when unset)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_MODEL_ID=eleven_flash_v2_5

DEFAULT_TZ=America/Vancouver

# Client-only; never put secrets behind NEXT_PUBLIC_
NEXT_PUBLIC_GESTURE_DEBUG=false
